// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// Every normal account is USER: a customer by default, and a provider once
// they have a provider profile. Provider access is not a role.
enum UserRole {
  USER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

// Which side of the app the user is currently using. This is only a UI
// preference: provider permissions come from having a ProviderProfile.
enum ActiveMode {
  CUSTOMER
  PROVIDER
}

// A provider is only listed to customers once an admin approves their NIC.
enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

// How far a provider is willing to serve. NEARBY uses their location for
// customer matching (logic added later); ISLAND_WIDE serves everyone.
enum ServiceCoverage {
  ISLAND_WIDE
  NEARBY
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  email           String           @unique
  passwordHash    String           @map("password_hash")
  name            String
  mobileNumber    String           @map("mobile_number")
  gender          Gender
  role            UserRole         @default(USER)
  status          AccountStatus    @default(ACTIVE)
  activeMode      ActiveMode       @default(CUSTOMER) @map("active_mode")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  providerProfile ProviderProfile?

  @@map("users")
}

model ServiceCategory {
  id          String                    @id @default(uuid()) @db.Uuid
  name        String                    @unique
  slug        String                    @unique
  description String?
  isActive    Boolean                   @default(true) @map("is_active")
  createdAt   DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime                  @updatedAt @map("updated_at") @db.Timestamptz
  providers   ProviderProfileCategory[]

  @@map("service_categories")
}

model ProviderProfile {
  id                 String                    @id @default(uuid()) @db.Uuid
  userId             String                    @unique @map("user_id") @db.Uuid
  businessName       String?                   @map("business_name")
  bio                String // the provider's description of what they do
  yearsOfExperience  Int                       @map("years_of_experience")
  serviceCoverage    ServiceCoverage           @map("service_coverage")
  location           String // base location
  hourlyRate         Int                       @map("hourly_rate") // whole rupees, no decimals
  specialization     String? // AI-suggested, editable
  skills             String[] // AI-suggested, editable
  verificationStatus VerificationStatus        @default(PENDING) @map("verification_status")
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories         ProviderProfileCategory[]
  verification       ProviderVerification?
  workSamples        ProviderWorkSample[]

  @@map("provider_profiles")
}

// Sensitive KYC data kept in its own table so access can be locked down and
// it is never sent to customers. Only paths to the images are stored here.
model ProviderVerification {
  id                String          @id @default(uuid()) @db.Uuid
  providerProfileId String          @unique @map("provider_profile_id") @db.Uuid
  nicNumber         String          @map("nic_number")
  nicFrontImagePath String          @map("nic_front_image_path")
  nicBackImagePath  String          @map("nic_back_image_path")
  reviewedById      String?         @map("reviewed_by_id") @db.Uuid // admin who reviewed
  reviewedAt        DateTime?       @map("reviewed_at") @db.Timestamptz
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)

  @@map("provider_verifications")
}

// Optional portfolio: one row per work sample (an image path + a short caption).
model ProviderWorkSample {
  id                String          @id @default(uuid()) @db.Uuid
  providerProfileId String          @map("provider_profile_id") @db.Uuid
  imagePath         String          @map("image_path")
  caption           String
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)

  @@index([providerProfileId])
  @@map("provider_work_samples")
}

model ProviderProfileCategory {
  providerProfileId String          @map("provider_profile_id") @db.Uuid
  categoryId        String          @map("category_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  category          ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([providerProfileId, categoryId])
  @@index([categoryId])
  @@map("provider_profile_categories")
}